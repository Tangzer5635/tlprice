# Copier ce fichier en .env puis remplir.

# Cle de chiffrement des cles privees Enable Banking (32 octets base64).
# Generer avec : openssl rand -base64 32
# A SAUVEGARDER : si elle est perdue, chaque utilisateur devra refournir sa cle .pem.
TLPRICE_CLE_CHIFFREMENT=

# URL publique de callback, en HTTPS. Chaque utilisateur la declare dans
# les "Allowed redirect URLs" de SA propre application Enable Banking.
TLPRICE_REDIRECT_URL=https://mondomaine.fr/banque/callback

# Duree de la connexion avant que le mot de passe soit redemande (heures).
# Defaut 48. Le cookie est signe avec une cle derivee de
# TLPRICE_CLE_CHIFFREMENT : il survit aux redeploiements.
TLPRICE_CONNEXION_DUREE_HEURES=48

# Mot de passe PostgreSQL (libre, utilise uniquement entre les conteneurs).
DB_PASSWORD=

# --- Web Push (notifications iPhone) : sans ces cles, le push est desactive.
# Generer UNE SEULE FOIS, puis ne plus jamais y toucher :
#     npx web-push generate-vapid-keys
# Si elles changent, tous les appareils deja abonnes cessent de recevoir
# et doivent se reabonner. A SAUVEGARDER avec le reste du .env.
TLPRICE_VAPID_CLE_PUBLIQUE=
TLPRICE_VAPID_CLE_PRIVEE=
# Adresse de contact exigee par la norme VAPID (mailto: ou https:).
TLPRICE_VAPID_SUJET=mailto:ton.adresse@exemple.fr

# --- SMTP (optionnel) : sans ces variables, le recap email est desactive.
# Exemple pour Gmail (mot de passe d application obligatoire) :
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
