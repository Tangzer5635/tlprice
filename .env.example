# Copier ce fichier en .env puis remplir (ou laisser scripts/installer-pi.sh
# le generer). Format strict CLE=valeur, une par ligne, sans espaces autour du =.
# Ce fichier contient TOUS les secrets : chmod 600, et une copie hors du Pi.

# --- Image Docker -----------------------------------------------------------
# Construite par GitHub Actions a chaque push sur main.
# TLPRICE_IMAGE=ghcr.io/tangzer5635/tlprice:latest

# Prefixe des volumes Docker. Les installations existantes lancees depuis
# ~/tlprices ont des volumes "tlprices_donnees_db" : garder "tlprices".
# Verifier avec : docker volume ls
TLPRICE_VOLUME_PREFIXE=tlprices

# Port expose sur le Pi, et interface d ecoute. 127.0.0.1 = uniquement
# joignable depuis le Pi (cloudflared / Caddy installes sur le Pi).
# TLPRICE_PORT=8082
# TLPRICE_ECOUTE=127.0.0.1

# --- Secrets -----------------------------------------------------------------
# Cle de chiffrement des cles privees Enable Banking et du SMTP (32 octets base64).
# Generer avec : openssl rand -base64 32
# A SAUVEGARDER : si elle est perdue, chaque utilisateur devra refournir sa cle .pem.
TLPRICE_CLE_CHIFFREMENT=

# Mot de passe PostgreSQL (libre, utilise uniquement entre les conteneurs).
DB_PASSWORD=

# --- Application -------------------------------------------------------------
# URL publique de callback, en HTTPS. Chaque utilisateur la declare dans
# les "Allowed redirect URLs" de SA propre application Enable Banking.
TLPRICE_REDIRECT_URL=https://mondomaine.fr/banque/callback

# Duree de la connexion avant que le mot de passe soit redemande (heures).
# Sur une app iPhone, 720 (30 jours) est confortable : le bruteforce est
# freine par ailleurs. Changer son mot de passe deconnecte tous les appareils.
TLPRICE_CONNEXION_DUREE_HEURES=720

# Inscriptions : fermees par defaut (le tout premier compte reste possible).
# Passer a true le temps d inviter quelqu un, puis remettre false.
TLPRICE_INSCRIPTION_OUVERTE=false

# Fuseau horaire des calculs (« aujourd hui », recaps, sauvegardes).
# TLPRICE_FUSEAU=Europe/Paris

# --- Web Push (notifications iPhone) : sans ces cles, le push est desactive.
# Generer UNE SEULE FOIS, puis ne plus jamais y toucher :
#     npx web-push generate-vapid-keys
# Si elles changent, tous les appareils deja abonnes cessent de recevoir
# et doivent se reabonner.
TLPRICE_VAPID_CLE_PUBLIQUE=
TLPRICE_VAPID_CLE_PRIVEE=
# Adresse de contact exigee par la norme VAPID (mailto: ou https:).
TLPRICE_VAPID_SUJET=mailto:ton.adresse@exemple.fr

# --- SMTP (optionnel) : sans ces variables, le recap email est desactive.
# Exemple pour Gmail (mot de passe d application obligatoire) :
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Sauvegardes (scripts/sauvegarde-pg.sh) -----------------------------------
# Dossier des dumps : idealement une cle USB ou un disque, PAS la carte SD.
TLPRICE_SAUVEGARDES=/home/pi/tlprice-sauvegardes
# Jours de dumps conserves.
TLPRICE_RETENTION=30
# Copie hors site avec rclone (ex. gdrive:tlprice). Vide = desactive.
TLPRICE_RCLONE_DEST=
